<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#2C322F"
    android:gravity="center"
    android:layout_margin="16dp">

    <!-- Category Name Section -->
    <TextView
        android:id="@+id/modal_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category Name"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/lalezar"
        />

<!--    rounded corners-->
    <EditText
        android:id="@+id/new_modal_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#454E49"
        android:hint="Enter category name"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#B3B3B3"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/lalezar"

        />

    <!-- Cover Photo Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cover Photo"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/lalezar"
        />

    <LinearLayout
        android:id="@+id/cover_photo_section"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#454E49"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/cover_photo_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_upload"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/upload_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload a photo"
            android:textColor="#88C167"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/lalezar" />
    </LinearLayout>



    <!-- Save and Cancel Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/save_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            android:fontFamily="@font/lalezar"
            android:textSize="20dp"
            android:backgroundTint="#4D7D3C"
            android:textColor="#ffffff"/>

        <View
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lalezar"
            android:textSize="20dp"
            android:text="Cancel"
            android:backgroundTint="#AE6436"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
