<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp"
    android:padding="0dp">

    <!-- Bullet Point as a Shape -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp">

        <!-- Bullet Point as a Shape -->
        <View
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bullet_shape"
            android:backgroundTint="#D94209" />

        <!-- + Symbol centered on the bullet -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginLeft="5.5dp"/>
    </FrameLayout>

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/add_new_ingredient_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Add Ingredient"
        android:textColor="#D94209"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/lalezar" />

<!--    &lt;!&ndash; Quantity &ndash;&gt;-->
<!--    <TextView-->
<!--        android:id="@+id/add_new_ingredient_quantity"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Quantity"-->
<!--        android:textColor="#000000"-->
<!--        android:textSize="16sp"-->
<!--        android:fontFamily="@font/lalezar" />-->
</LinearLayout>
