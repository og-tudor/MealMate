<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0CFB7">

    <include
        android:id="@+id/navigation_footer"
        layout="@layout/navigation_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/navigation_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_header">

        <!-- FrameLayout to overlay text and sections -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- Your existing FrameLayout -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="143dp"
                android:padding="0dp">

                <!-- Horizontal LinearLayout for the two sections -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Left Section (25% width) -->
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#FFAE6436">
                        <!-- Add content for the left section here if needed -->
                    </LinearLayout>

                    <!-- Right Section (75% width) -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3">

                        <!-- Image View -->
                        <ImageView
                            android:id="@+id/recipe_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/placeholder" />

                        <!-- Gradient Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/recipe_gradient_overlay" />

                        <!-- FrameLayout to position the tags at the bottom right -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="0dp"
                            android:gravity="bottom|end"
                            android:padding="0dp">

                            <!-- Horizontal LinearLayout for Tags -->
                            <LinearLayout
                                android:id="@+id/category_badges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="16dp"
                                android:gravity="bottom|end"
                                android:orientation="horizontal">

                                <!-- Category Badges -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/recipe_tag_background"
                                    android:padding="8dp"
                                    android:text="Italian"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/recipe_tag_background"
                                    android:padding="8dp"
                                    android:text="Vegetarian"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- TextView overlayed on top -->
                <TextView
                    android:id="@+id/recipe_name"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:padding="15dp"
                    android:text="PlaceHolder Recipe Name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>


            <!-- Ingredient Section -->
            <LinearLayout
                android:id="@+id/ingredient_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0CFB7"
                android:orientation="vertical"
                android:padding="16dp">

            </LinearLayout>
            <include
                layout="@layout/ingredient_add_new_row"
                android:id="@+id/addNewIngredientRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginLeft="16dp"
                app:layout_constraintTop_toBottomOf="@id/ingredient_section"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Horizontal spacer line-->
            <View
                android:id="@+id/spacer_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#1E2220" />

            <ImageView
                android:id="@+id/icon_edit_instructions"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="right"
                android:src="@drawable/icon_edit"
                android:contentDescription="Edit Icon"
                app:layout_constraintTop_toBottomOf="@id/spacer_line"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="#D94209" />

            <!-- Instructions Section -->
            <LinearLayout
                android:id="@+id/instructions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Editable instruction item -->
<!--                <EditText-->
<!--                    android:id="@+id/instruction_1"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="1. Placeholder instruction."-->
<!--                    android:fontFamily="@font/lateef"-->
<!--                    android:textColor="#000000"-->
<!--                    android:textSize="14sp"-->
<!--                    android:focusable="false"-->
<!--                    android:focusableInTouchMode="false"-->
<!--                    android:background="@null"/>-->

                <!-- Repeat EditText for each instruction item -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- Edit Button Image positioned below and to the right of the header -->
    <ImageView
        android:id="@+id/edit_recipe_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/edit_recipe_button"
        android:layout_marginEnd="-2dp"
        android:layout_marginTop="-4dp"
        android:visibility="invisible"
        android:contentDescription="Edit Recipe Button"
        app:layout_constraintTop_toBottomOf="@id/search_header"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/save_edit_recipe_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/save_recipe_edit_button"
        android:layout_marginEnd="-2dp"
        android:visibility="invisible"
        android:layout_marginTop="-4dp"
        android:contentDescription="Edit Recipe Button"
        app:layout_constraintTop_toBottomOf="@id/search_header"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Container LinearLayout for Search Bar and Icon -->
    <include
        android:id="@+id/search_header"
        layout="@layout/search_header"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <include
        layout="@layout/button_save_recipe"
        android:id="@+id/saveRecipeButtonLayout"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="100dp"
        android:visibility="invisible"
        android:layout_marginEnd="-30dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
