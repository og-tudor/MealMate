<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2220">

    <include
        android:id="@+id/navigation_footer"
        layout="@layout/navigation_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo at the top-right corner -->
    <ImageView
        android:id="@+id/logo_small"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/logo_small"
        android:contentDescription="Small logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

    <!-- Rounded and centered profile picture -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile_picture"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icon_chef"
        android:contentDescription="Profile picture"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedImage" />

    <!-- Horizontal layout for Email label and email display -->
    <LinearLayout
        android:id="@+id/settings_email_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/dropdown_rounded_background"
        app:layout_constraintTop_toBottomOf="@id/profile_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp">

        <TextView
            android:id="@+id/settings_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/settings_email_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="placeholder@gmail.com"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Logout button -->
    <Button
        android:id="@+id/logout_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6C2E2E"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/settings_email_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="64dp" />

    <Button
        android:id="@+id/notification_token_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Get Token"
        android:textColor="#FFFFFF"
        android:backgroundTint="#306C2E"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/logout_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="64dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
